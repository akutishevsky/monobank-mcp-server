  },
  "homepage": "https://github.com/akutishevsky/monobank-mcp-server#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "prettier": "^3.8.1",
    "typescript": "^7.0.2"
  }
