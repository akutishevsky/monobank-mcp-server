{
  "name": "monobank-mcp-server",
  "version": "1.2.0",
  "mcpName": "io.github.akutishevsky/monobank-mcp-server",
  "description": "MCP server for Monobank API integration",
  "main": "index.js",
  "bin": {
    "monobank-mcp-server": "./build/index.js"
  },
